# All optional for local development.
PORT=3001
# DATA_DIR=/var/data        # where clinic.db lives (needs a persistent disk in production)
# AUTH_SECRET=              # signing key for staff/client tokens; generated and stored if unset
# DEMO_PIN=1234             # PIN for the seeded demo staff accounts
# NODE_ENV=production       # hides the on-screen client OTP and demo sign-in chips
# DEMO_MODE=0               # on Vercel, demo mode is default-on; 0 disables it# TRUST_PROXY=1             # number of proxies in front of the API
# PUBLIC_URL=https://your-app.vercel.app
